{
  "info": {
    "_postman_id": "toolshop-api-automation-poc",
    "name": "Toolshop API Automation",
    "description": "Authenticated API automation against Toolshop: register, login, Bearer token, cart journey, assertions, and negative cases. Run with Newman in CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Setup",
      "item": [
        {
          "name": "Register Unique User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = `${Date.now()}${Math.floor(Math.random() * 1000)}`;",
                  "pm.environment.set('email', `qa.postman.${stamp}@example.com`);",
                  "pm.environment.set('password', `Hyb!${stamp}Qa#9`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('register response includes user id', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"dob\": \"1990-01-15\",\n  \"phone\": \"5550100123\",\n  \"address\": {\n    \"street\": \"Test Street\",\n    \"house_number\": \"12\",\n    \"city\": \"Utrecht\",\n    \"state\": \"UT\",\n    \"country\": \"NL\",\n    \"postal_code\": \"3511AB\"\n  }\n}"
            },
            "url": "{{base_url}}/users/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('login returns access_token', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('access_token', body.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/users/login"
          }
        }
      ]
    },
    {
      "name": "Authenticated Positive",
      "item": [
        {
          "name": "GET /users/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('profile returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('profile email matches registered user', function () {",
                  "    pm.expect(pm.response.json().email).to.eql(pm.environment.get('email'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/users/me"
          }
        },
        {
          "name": "GET /products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('catalog returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('catalog has in-stock product', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.be.an('array').that.is.not.empty;",
                  "    const product = data.find((item) => item.in_stock) || data[0];",
                  "    pm.environment.set('product_id', product.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/products?page=1"
          }
        },
        {
          "name": "POST /carts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create cart returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('cart id is saved', function () {",
                  "    const cartId = pm.response.json().id;",
                  "    pm.expect(cartId).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('cart_id', cartId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{base_url}}/carts"
          }
        },
        {
          "name": "POST /carts/:id add item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('add item succeeds', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{base_url}}/carts/{{cart_id}}"
          }
        },
        {
          "name": "GET /carts/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('get cart returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('cart contains added product', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(pm.environment.get('cart_id'));",
                  "    pm.expect(body.cart_items[0].product_id).to.eql(pm.environment.get('product_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/carts/{{cart_id}}"
          }
        },
        {
          "name": "DELETE /carts/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete cart succeeds', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/carts/{{cart_id}}"
          }
        }
      ]
    },
    {
      "name": "Negative Tests",
      "item": [
        {
          "name": "GET /users/me without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing token is rejected', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/users/me"
          }
        },
        {
          "name": "POST /users/login invalid password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invalid credentials are rejected', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 422]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password-123\"\n}"
            },
            "url": "{{base_url}}/users/login"
          }
        },
        {
          "name": "GET /carts/:id invalid cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unknown cart returns 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{base_url}}/carts/00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    },
    {
      "name": "Data Validation",
      "item": [
        {
          "name": "Product schema validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('product has required catalog fields', function () {",
                  "    const product = pm.response.json().data[0];",
                  "    pm.expect(product.id).to.be.a('string');",
                  "    pm.expect(product.name).to.be.a('string');",
                  "    pm.expect(product.price).to.be.a('number');",
                  "    pm.expect(product.in_stock).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('response time under 3 seconds', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/products?page=1"
          }
        }
      ]
    }
  ]
}
