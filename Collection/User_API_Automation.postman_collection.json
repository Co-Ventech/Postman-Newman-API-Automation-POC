        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify create user status code\", function(){\r",
                  "\r",
                  "    pm.response.to.have.status(201);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Verify created user name\", function(){\r",
                  "\r",
                  "    var response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.name)\r",
                  "       .to.eql(\"Alex Hales\");\r",
                  "\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Verify response contains id\", function(){\r",
                  "\r",
                  "    var response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.id).to.exist;\r",
                  "\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
