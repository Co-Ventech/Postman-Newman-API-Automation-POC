    {
      "name": "Data Validation Tests",
      "item": [
        {
          "name": "Get Single User - Validate Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify status code is 200\", function () {\r",
                  "\r",
                  "    pm.response.to.have.status(200);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Verify user id matches requested user id\", function () {\r",
                  "\r",
                  "    var response = pm.response.json();\r",
                  "\r",
                  "    var expectedUserId = Number(pm.environment.get(\"user_id\"));\r",
                  "\r",
                  "    pm.expect(response.id)\r",
                  "        .to.eql(expectedUserId);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Verify mandatory fields exist\", function () {\r",
                  "\r",
                  "    var response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.name).to.exist;\r",
                  "\r",
                  "    pm.expect(response.username).to.exist;\r",
                  "\r",
                  "    pm.expect(response.email).to.exist;\r",
                  "\r",
                  "});"
